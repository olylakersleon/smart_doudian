{
  "page_name": "订单管理-Element",
  "url": "https://example.com/order/list",
  "framework": "element-plus",
  "raw_html": "<div class='el-table'><div class='el-date-editor'><input/></div><button class='el-button'>搜索</button><table><tr><td>ORDER_2002</td><td><button>详情</button></td></tr></table></div>",
  "elements": [
    {"name": "订单号输入框", "selector": "input[placeholder*='订单号']", "role": "search_input", "text": ""},
    {"name": "日期输入", "selector": ".el-date-editor input", "role": "date_input", "text": ""},
    {"name": "日期确认", "selector": ".el-picker-panel__footer .el-button--primary", "role": "date_confirm", "text": "确定"},
    {"name": "搜索按钮", "selector": "button:has-text('搜索')", "role": "search_button", "text": "搜索"},
    {"name": "订单列表首行", "selector": "table tr:nth-child(1)", "role": "order_row", "text": "ORDER_2002"},
    {"name": "详情按钮", "selector": "button:has-text('详情')", "role": "detail_button", "text": "详情"}
  ]
}
